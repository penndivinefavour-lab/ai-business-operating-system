# Demo mode - no credentials required
DEMO_MODE=true
PORT=4000
DASHBOARD_PORT=3000

# PocketBase (will be auto-downloaded if not present)
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@hotel.com
POCKETBASE_ADMIN_PASSWORD=admin123456

# AI Provider (optional in demo mode - mock AI used if not set)
# AI_PROVIDER=mock
# AI_API_KEY=

# WhatsApp Provider (mock for demo)
WHATSAPP_PROVIDER=mock
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# Production settings (uncomment for real deployment)
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# WHATSAPP_PROVIDER=whatsapp
# WHATSAPP_API_KEY=...
# WHATSAPP_PHONE_NUMBER_ID=...
