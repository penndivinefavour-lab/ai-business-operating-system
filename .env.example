# AI Business Operating System — Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
PRODUCTION=false
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────
DATA_DIR=./data
DATABASE_URL=frontdesk.db

# ─── Security ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=dev-insecure-secret-change-me-in-production
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=24

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g., https://yourdomain.com)
# Leave empty or set to * for development
CORS_ORIGIN=

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
RATE_LIMIT_AUTH_MAX=10

# ─── AI Provider ───────────────────────────────────────────────────────────
# Options: demo, anthropic, openai-compatible
AI_PROVIDER=demo

# Anthropic (if AI_PROVIDER=anthropic)
AI_API_KEY=
AI_MODEL=claude-3-5-haiku-latest

# OpenAI-compatible (if AI_PROVIDER=openai-compatible)
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1

AI_COMPOSE_REPLIES=true
AI_TIMEOUT_MS=30000

# ─── WhatsApp (Official Cloud API) ─────────────────────────────────────────
# Get these from Meta Developer Portal > WhatsApp > Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0

# ─── Admin ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@demo.hotel
ADMIN_PASSWORD=change-me-in-production
ADMIN_API_TOKEN=

# ─── SMTP (optional) ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI Front Desk <no-reply@yourdomain.com>
